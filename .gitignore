## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (DotSettings)
*.csproj.DotSettings.user

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Xx]64/
[Xx]86/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Vv]isualStudioToolsSDK/

# Visual Studio 2015/2017 cache/options directory
.vs/
# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# Visual Studio 2017 AutoGenerated files
Generated\ Files/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Build Tasks of GuardCheck
_GuardCheck.*

# Kendo UI SDK
lib/KENDO*/

# Parasoft Jtest
.jtesttest

# Roslyn Analysis Queues
*.analysisresults
*.analysisqueue

# Microsoft Azure Build Output
Anthem.Publish.xml
ServiceDefinition.build.csdef

# Roslyn Code Analysis
*.CodeAnalysisLog.xml
*.lastcodeanalysistools.log

# Entity Framework 6+ (as per .gitignore template)
*.msl
*.ssdl
*.csdl
*.edmx.diagram
*.edmx.sql

# Entity Framework Power Tools
*.Migrations.cs

# Entity Framework Core
# Migration SQL scripts
*.sql

# ReSharper is a popular Visual Studio add-on
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JustCode
.JustCode

# TeamCity
_TeamCity*

# Omoni
.omoni

# DotCover
*.dotCover

# AxoCover
.axoCover/

# JetBrains Rider
.idea/
*.sln.iml

# Visual Studio Code
.vscode/

# Visual Studio Profiler
*.psess
*.vsp
*.vspx
*.sap

# TraceLogFiles
*.svclog
*.utp

# NCrunch
_NCrunch_*
.*ncrunch*
*.ncrunchproject

# MightyMoose
*.mm.*
AutoTest.Net/

# Web workbench (sass)
.sass-cache/

# Installshield output folder
[Ee]xpress/

# DocProject is a documentation generator add-on
DocProject/buildhelp/
DocProject/Help/*.HxT
DocProject/Help/*.HxC
DocProject/Help/*.hhc
DocProject/Help/*.hhk
DocProject/Help/*.hhp
DocProject/Help/Html2
DocProject/Help/html

# ClickOnce directory
publish/

# Publishing professor
Publish/

# StyleCop
StyleCopReport.xml

# Antlr (generated files)
*.tokens

# Adobe Photoshop temporary files
*.psd.tmp

# Syncfusion (generated files)
Syncfusion.Licensing.dll

# Microsoft SQL Server files
*.mdf
*.ldf
*.ndf

# Business Intelligence projects
*.rdl.data
*.bim.layout
*.bim_*.settings
*.rptproj.bak

# Microsoft Sharepoint
*.orig

# FAKE - Fake build tool
.fake/

# Paket - Dependency manager for .NET
.paket/

# GhostDoc
*.GhostDoc.xml

# Node.js
node_modules/

# Python (generated files)
__pycache__/
*.py[cod]

# Log files
*.log

# Temp files
*.tmp
